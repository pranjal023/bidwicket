{
  "name": "bidwicket-server",
  "version": "1.0.0",
  "private": true,
  "description": "BidWicket - Live Cricket Auction (Express + Socket.io + MongoDB server)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed/seed.js",
    "simulate": "node scripts/simulate.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/squadRules.test.js tests/bidRules.test.js tests/poolParser.test.js",
    "test:concurrency": "jest tests/concurrency.test.js --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "socket.io-client": "^4.7.5"
  },
  "engines": { "node": ">=18" }
}
